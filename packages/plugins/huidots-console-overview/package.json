{
  "name": "@huidots/huidots-console-overview",
  "version": "0.1.0",
  "description": "HuiDots Console — Live Company State Screen. F1 dashboard surfacing Paperclip state (agents, open issues, attention, runs, goals, costs) plus per-project Vault and Pixel Agents scaffolding.",
  "type": "module",
  "private": true,
  "exports": {
    ".": "./src/index.ts"
  },
  "paperclipPlugin": {
    "manifest": "./dist/manifest.js",
    "worker": "./dist/worker.js",
    "ui": "./dist/ui/"
  },
  "scripts": {
    "prebuild": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps",
    "build": "tsc -p tsconfig.json && node ./scripts/build-ui.mjs",
    "clean": "rm -rf dist",
    "typecheck": "pnpm --filter @paperclipai/plugin-sdk ensure-build-deps && tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ./vitest.config.ts",
    "check:vault-readonly": "node ./scripts/check-vault-readonly.mjs"
  },
  "dependencies": {
    "@paperclipai/plugin-sdk": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "esbuild": "^0.28.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "typescript": "^5.7.3"
  },
  "peerDependencies": {
    "react": ">=18"
  }
}
